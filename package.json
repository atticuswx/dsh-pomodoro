{
  "name": "@local/dsh-pomodoro",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A Pomodoro timer for the DSH Web GUI: a draggable floating window that stays visible without an open session, plus an optional dock pill, sharing one focus/break countdown with cycle dots, chime, notifications, and local preferences.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
